<mxfile host="app.diagrams.net"><diagram id="backend" name="Backend packages"><mxGraphModel grid="1" page="1" pageWidth="1500" pageHeight="1680"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;BACKEND PACKAGE DIAGRAM&lt;/b&gt;&lt;br&gt;&lt;br&gt;C?u tr?c t?ng qu?t cho to?n backend ? Warehouse Management System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1440" height="80" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;?package? WMS.API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gateway: ApiServiceProxy / ApiServiceProxyExtensions (YARP)&lt;br&gt;Controllers: AdminAuditController ? AuditGateway&lt;br&gt;Program.cs: DI, c?u h?nh v? HTTP pipeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#334155;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="420" y="125" width="640" height="150" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;?package? WMS.ServiceDefaults&lt;/b&gt;&lt;br&gt;&lt;br&gt;B?o m?t / session / CSRF / l?i chung&lt;br&gt;D?ng b?i WMS.API v? c?c API:&lt;br&gt;Catalog, Warehouse, Procurement, Inventory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4edff;strokeColor=#334155;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="125" width="330" height="150" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;?package? WMS.Audit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Audit contracts / SQL reader / redaction&lt;br&gt;D?ng b?i WMS.API, Procurement.API,&lt;br&gt;Inventory.API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4edff;strokeColor=#334155;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1120" y="125" width="350" height="150" as="geometry"/></mxCell><mxCell id="apis" value="&lt;b&gt;API c?a c?c service&lt;/b&gt;&lt;br