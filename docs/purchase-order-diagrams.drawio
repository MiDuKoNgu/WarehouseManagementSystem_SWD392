FindAsync(id)" style="endArrow=block;endFill=1;dashed=0;strokeColor=#475569;strokeWidth=1.3;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=246;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1770" y="15397" as="sourcePoint"/><mxPoint x="2040" y="15397" as="targetPoint"/></mxGeometry></mxCell><mxCell id="202" value="172. StoredPurchaseOrder" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.3;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=516;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1770" y="15499" as="sourcePoint"/><mxPoint x="1230" y="15499" as="targetPoint"/></mxGeometry></mxCell><mxCell id="203" value="173. Gán entry.CreatedId = order.PurchaseOrderId" style="endArrow=block;endFill=1;dashed=0;strokeColor=#475569;strokeWidth=1.3;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=3486;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="15573" as="sourcePoint"/><mxPoint x="4740" y="15573" as="targetPoint"/></mxGeometry></mxCell><mxCell id="204" value="174. PurchaseOrderDetail" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.3;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=246;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="15647" as="sourcePoint"/><mxPoint x="960" y="15647" as="targetPoint"/></mxGeometry></mxCell><mxCell id="205" value="175. 201 CreatedAtAction(Detail)" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.3;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=246;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="15721" as="sourcePoint"/><mxPoint x="690" y="15721" as="targetPoint"/></mxGeometry></mxCell><mxCell id="206" value="176. 201 PO DRAFT" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.3;fontSize=13;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=246;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="15795" as="sourcePoint"/><mxPoint x="420" y="15795" as="targetPoint"/></mxGeometry></mxCell><mxCell id="208" value="finally: Entry.Gate.Release() cho cả nhánh thành công/lỗi. Preview chỉ lưu bộ nhớ (singleton), không ghi PO. Import confirm chống tạo trùng bằng Gate + CreatedId + khóa/importKey bền vững trong AuditLog. Muốn DRAFT → CONFIRMED phải gọi /{id}/confirm riêng." style="rounded=1;fillColor=#fff7d6;strokeColor=#e9c46a;align=left;spacing=12;fontSize=14;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="15889" width="4830" height="65" as="geometry"/></mxCell><mxCell id="209" value="Lỗi chính: 400 validation/file format; 401/403 session/role; 404 PO không có; 409 version/state/reservation/preview; 503 nguồn dữ liệu lỗi. Proxy có thể trả 502/504 khi upstream mất kết nối. Nguồn: PurchaseOrdersController.cs, PurchaseOrderService.cs, PurchaseOrderRepository.cs, PurchaseOrderLookupClient.cs, PurchaseOrderWorkbook.cs." style="rounded=1;fillColor=#fff7d6;strokeColor=#e9c46a;align=left;spacing=12;fontSize=14;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="15984" width="4830" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="po-class" name="Purchase Order - Class"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="2580" pageHeight="5220"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="PURCHASE ORDER — Class diagram" style="text;align=left;fontSize=28;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2500" height="45" as="geometry"/></mxCell><mxCell id="3" value="Procurement.API / BLL / DAL / Models / Excel — các lớp theo code hiện tại; các DTO là record độc lập, không suy diễn kế thừa giữa Detail và Summary." style="text;align=left;fontSize=14;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="2500" height="40" as="geometry"/></mxCell><mxCell id="4" value="Ký hiệu: + public; - private; {static} tĩnh; nét đứt = phụ thuộc; tam giác rỗng nét đứt = triển khai interface; nét liền + thuộc tính [số lượng] = liên kết dữ liệu.
Hiển thị thuộc tính/phương thức chính; … lược tham số và CancellationToken. Dependency qua constructor được ghi [DI], không giả định tên field private. «module»/«database»/«service context» là ngữ cảnh, không phải class C#." style="rounded=1;fillColor=#fff7d6;strokeColor=#e9c46a;align=left;spacing=12;fontSize=13;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="2500" height="65" as="geometry"/></mxCell><mxCell id="5" value="A. Frontend và API" style="text;align=left;fontSize=18;fontStyle=1;fontFamily=Arial;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="45" y="200" width="2490" height="32" as="geometry"/></mxCell><mxCell id="6" value="«frontend module»
