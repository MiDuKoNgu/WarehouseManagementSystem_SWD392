        <mxCell id="56" value="«note» Quy tắc wiring / triển khai" style="swimlane;startSize=62;horizontal=1;rounded=0;fillColor=#f1f5f9;swimlaneFillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=15;fontStyle=1;fontFamily=Arial;whiteSpace=wrap;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="2510" width="470" height="239" as="geometry" />
        </mxCell>
        <mxCell id="57" value="SqlAuditReader là MỘT class dùng tại hai service. Mỗi service đăng ký instance theo database riêng. AuditGateway gọi song song hai nguồn + Identity. ApiServiceProxy chuyển tiếp next cho endpoint admin local. AuditQuery/AuditPage/AuditDetail dùng chung qua HTTP." style="text;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="56">
          <mxGeometry x="0" y="62" width="470" height="135" as="geometry" />
        </mxCell>
        <mxCell id="58" value="—" style="text;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;whiteSpace=wrap;overflow=hidden;strokeColor=#cbd5e1;" vertex="1" parent="56">
          <mxGeometry x="0" y="197" width="470" height="42" as="geometry" />
        </mxCell>
