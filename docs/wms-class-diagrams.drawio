        <mxCell id="68" value="03 - Putaway — Class diagram" style="text;align=left;fontSize=28;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="69" value="Inventory.API / Inventory.BLL.Putaway / Inventory.DAL.Putaway / Inventory.Models.Putaway — service phụ thuộc interface; repository triển khai SQL và gọi rules/guard." style="text;align=left;fontSize=14;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="2500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="70" value="Ký hiệu: + public; - private; # protected; {static} tĩnh; nét đứt + mũi tên = phụ thuộc; tam giác rỗng nét đứt = triển khai interface; tam giác rỗng nét liền = kế thừa; nét liền + tên thuộc tính [số lượng] = liên kết DTO. Chỉ hiển thị thành viên liên quan chức năng. Chữ ký rút gọn bằng …; bỏ CancellationToken. «module», «React», «database» là ngữ cảnh, không phải class C#. Không dùng hình thoi để suy diễn quyền sở hữu vòng đời." style="rounded=1;align=left;spacing=12;fillColor=#fff7d6;strokeColor=#e9c46a;fontSize=13;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
