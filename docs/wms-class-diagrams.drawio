          <mxGeometry x="1950" y="2510" width="470" height="217" as="geometry" />
        </mxCell>
        <mxCell id="60" value="clients: IHttpClientFactory [constructor DI] Kế thừa AuthenticationHandler&lt;AuthenticationSchemeOptions&gt;" style="text;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="59">
          <mxGeometry x="0" y="62" width="470" height="66" as="geometry" />
        </mxCell>
        <mxCell id="61" value="# HandleAuthenticateAsync(): Task&lt;AuthenticateResult&gt; Gọi Identity /api/auth/me; tạo claims Các API đọc audit không yêu cầu CSRF" style="text;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;whiteSpace=wrap;overflow=hidden;strokeColor=#cbd5e1;" vertex="1" parent="59">
          <mxGeometry x="0" y="128" width="470" height="89" as="geometry" />
        </mxCell>
        <mxCell id="62" value="04 - Xem Audit — Class diagram" style="text;align=left;fontSize=28;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="63" value="WMS.API.Audit + WMS.Audit + Inventory.API + Procurement.API + Identity — tổng hợp lịch sử qua HTTP, đọc SQL tại từng service sở hữu dữ liệu." style="text;align=left;fontSize=14;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="2500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="64" value="Ký hiệu: + public; - private; # protected; {static} tĩnh; nét đứt + mũi tên = phụ thuộc; tam giác rỗng nét đứt = triển khai interface; tam giác rỗng nét liền = kế thừa; nét liền + tên thuộc tính [số lượng] = liên kết DTO. Chỉ hiển thị thành viên liên quan chức năng. Chữ ký rút gọn bằng …; bỏ CancellationToken. «module», «React», «database» là ngữ cảnh, không phải class C#. Không dùng hình thoi để suy diễn quyền sở hữu vòng đời." style="rounded=1;align=left;spacing=12;fillColor=#fff7d6;strokeColor=#e9c46a;fontSize=13;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="2500" height="68" as="geometry" />
        </mxCell>
        <mxCell id="65" value="A. API tổng hợp tại WMS.API" style="text;align=left;fontSize=18;fontStyle=1;fontFamily=Arial;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="45" y="185" width="2490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="66" value="B. Controller nguồn và class dùng chung" style="text;align=left;fontSize=18;fontStyle=1;fontFamily=Arial;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="45" y="755" width="2490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="67" value="C. Query, cursor, nguồn SQL và lọc dữ liệu nhạy cảm" style="text;align=left;fontSize=18;fontStyle=1;fontFamily=Arial;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="45" y="1325" width="2490" height="30" as="geometry" />
