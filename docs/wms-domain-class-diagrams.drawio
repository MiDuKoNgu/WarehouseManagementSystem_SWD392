        <mxCell id="14" value="1" style="text;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fillColor=#ffffff;fontSize=14;fontFamily=Arial;" vertex="1" connectable="0" parent="13">
          <mxGeometry x="-1" y="0" width="38" height="22" relative="1" as="geometry">
            <mxPoint x="8" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="15" value="0..*" style="text;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fillColor=#ffffff;fontSize=14;fontFamily=Arial;" vertex="1" connectable="0" parent="13">
          <mxGeometry x="1" y="0" width="38" height="22" relative="1" as="geometry">
            <mxPoint x="8" y="8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="16" value="UserID trong AuditLog là người thực hiện thao tác được ghi lại. Người đang xem lịch sử phải có role ADMIN; không có nghĩa mọi log đều do ADMIN tạo." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="700" width="760" height="115" as="geometry" />
        </mxCell>
        <mxCell id="17" value="AuditLog tồn tại trong cả ProcurementDB và InventoryDB. EntityName + EntityID mô tả đối tượng được ghi log (PurchaseOrder, Inbound, Putaway…). Đây không phải foreign key trực tiếp nên không vẽ quan hệ cứng tới từng model. Source, ActorName, BusinessGroup và DocumentCode là dữ liệu tổng hợp khi xem; không phải thuộc tính gốc của bảng AuditLog." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="855" width="850" height="170" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Phạm vi: thuộc tính và quan hệ chính của model gốc, suy ra từ dữ liệu/schema và SQL trong dự án; không phải bản sao các class DTO C#. Các trường trạng thái/loại/vai trò hiện là string; không khai báo enum nghiệp vụ. Quan hệ xuyên service là quan hệ nghiệp vụ, không mặc định là foreign key vật lý." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="45" y="1065" width="1390" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>