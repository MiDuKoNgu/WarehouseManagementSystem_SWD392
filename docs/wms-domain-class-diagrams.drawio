        </mxCell>
        <mxCell id="58" value="Không có model gốc “Putaway” riêng. Xác nhận putaway cập nhật SerialItem.CurrentLocationID và thêm SerialMovement có EventType = &quot;PUTAWAY&quot;. StorageLocation tạo cây bằng ParentLocationID." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="1680" width="720" height="95" as="geometry" />
        </mxCell>
        <mxCell id="59" value="Serial chờ putaway có CurrentLocationID = null; đã nhận chính thức và thuộc kho. ZoneStorageRule.BrandID = null nghĩa là không giới hạn một hãng cụ thể. Các Status / Type / State hiện là string." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="870" y="1680" width="700" height="95" as="geometry" />
        </mxCell>
        <mxCell id="60" value="Phạm vi: thuộc tính và quan hệ chính của model gốc, suy ra từ dữ liệu/schema và SQL trong dự án; không phải bản sao các class DTO C#. Các trường trạng thái/loại/vai trò hiện là string; không khai báo enum nghiệp vụ. Quan hệ xuyên service là quan hệ nghiệp vụ, không mặc định là foreign key vật lý." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="45" y="1785" width="1550" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
