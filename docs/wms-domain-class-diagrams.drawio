            <mxPoint x="-45" y="-25" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="39" value="Phiếu DRAFT có thể chưa có dòng: Inbound → InboundItem là 0..*. Khi DONE cần ít nhất một serial; mỗi InboundItem liên kết tối đa một SerialItem. SerialItem có thể có nguồn khác ngoài nhập mua." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="1170" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="40" value="WarehouseID trong migration cho phép null cho dữ liệu cũ. Phiếu mới được tạo phải thuộc kho của nhân viên. CreatedByUserID: người tạo; PerformedByUserID: người hoàn tất/hủy (có thể null). Chỉ vẽ quan hệ người tạo để dễ đọc." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="1420" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="41" value="Không cần thêm class “InboundService” hay “ReceiptDetail”. Inbound, InboundItem và SerialItem là các model dữ liệu gốc của chức năng." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1730" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Phạm vi: thuộc tính và quan hệ chính của model gốc, suy ra từ dữ liệu/schema và SQL trong dự án; không phải bản sao các class DTO C#. Các trường trạng thái/loại/vai trò hiện là string; không khai báo enum nghiệp vụ. Quan hệ xuyên service là quan hệ nghiệp vụ, không mặc định là foreign key vật lý." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="45" y="1825" width="1460" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
