        <mxCell id="16" value="Login sử dụng Username + PasswordHash, Status và RoleName. Role được hỗ trợ: ADMIN, PURCHASING_STAFF, WAREHOUSE_STAFF. UserRoles là static class chứa const string, không phải enum." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="460" height="145" as="geometry" />
        </mxCell>
        <mxCell id="17" value="WarehouseID có thể null với tài khoản không làm việc tại kho. Đăng nhập với WAREHOUSE_STAFF yêu cầu WarehouseID &gt; 0. Không thêm các hàm isActive()/hasRole() vào model vì code hiện đặt quy tắc ở service." style="shape=note;size=16;fillColor=#fffdf2;strokeColor=#9ca3af;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1000" y="800" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Phạm vi: thuộc tính và quan hệ chính của model gốc, suy ra từ dữ liệu/schema và SQL trong dự án; không phải bản sao các class DTO C#. Các trường trạng thái/loại/vai trò hiện là string; không khai báo enum nghiệp vụ. Quan hệ xuyên service là quan hệ nghiệp vụ, không mặc định là foreign key vật lý." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="45" y="1025" width="1410" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
