        <mxCell id="135" value="Lỗi chính: 400 dữ liệu; 403 kho/quyền/chính sách; 404 không tìm thấy; 409 serial/version/PO xung đột; 503 dịch vụ lỗi. Transaction chưa commit sẽ rollback. Nếu DONE đã commit nhưng Release thất bại, retry complete không nhận hàng lần hai. Nguồn: InboundsController.cs, SqlInboundRepository.cs, ReceivingOrderClient.cs, ReceivingOrdersController.cs." style="rounded=1;fillColor=#fff7d6;strokeColor=#e9c46a;align=left;spacing=12;fontSize=13;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="9760" width="3265" height="62" as="geometry" />
        </mxCell>
      </root>
