        <mxCell id="2" value="1. Chọn confirm / cancel / close" style="endArrow=block;endFill=1;dashed=0;strokeColor=#334155;strokeWidth=1.4;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=282;verticalAlign=bottom;spacingBottom=8;rounded=0;" edge="1" parent="1">
