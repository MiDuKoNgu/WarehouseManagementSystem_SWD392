          <mxGeometry x="40" y="4692" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="54" value="ref  SD07.ORDER orders.FindAsync(header.PurchaseOrderId)" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD07">
          <mxGeometry x="965" y="5139" width="2120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="110" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="6195" width="3050" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
