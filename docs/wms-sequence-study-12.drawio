        </mxCell>
        <mxCell id="36" value="break [Reservation đang ngăn thao tác]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3584" width="3350" height="32" as="geometry" />
        </mxCell>
        <mxCell id="40" value="opt [target=CLOSED]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3802" width="3350" height="32" as="geometry" />
        </mxCell>
        <mxCell id="50" value="Không vẽ ba sequence trùng nhau: thay action, điều kiện và targetStatus theo bảng trên. Update PO dùng SD04, vì sửa dòng hàng khác TransitionAsync." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="4731" width="3350" height="86" as="geometry" />
        </mxCell>
        <mxCell id="94" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="4937" width="3360" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
