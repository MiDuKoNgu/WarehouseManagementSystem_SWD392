        <mxCell id="48" value="Login chưa có phiên nên không ref SD02. RememberMe: 14 ngày persistent; không chọn: session cookie, ticket 8 giờ. Claims và cookie là xử lý của controller/framework, không phải model User." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="4347" width="2420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="85" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
