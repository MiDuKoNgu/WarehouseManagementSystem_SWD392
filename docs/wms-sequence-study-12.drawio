        </mxCell>
        <mxCell id="40" value="Lời gọi nội bộ đi thẳng Identity.API, không vòng qua WMS.API. Lỗi Identity/SQL → 503. SD02 được gọi trước mỗi endpoint được bảo vệ; ref SESSION chỉ là đoạn kiểm cookie, không gọi đệ quy toàn bộ SD02." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="3371" width="1800" height="86" as="geometry" />
        </mxCell>
        <mxCell id="67" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="3577" width="1810" height="55" as="geometry" />
        </mxCell>
      </root>
