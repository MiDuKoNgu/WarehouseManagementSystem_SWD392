        </mxCell>
        <mxCell id="21" value="else [CANCEL và chưa CANCELLED]" style="text;fillColor=#ffffff;align=left;fontStyle=1;fontSize=14;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="2257" width="3040" height="35" as="geometry" />
        </mxCell>
        <mxCell id="29" value="interaction SD09.RELEASE — Giải phóng reservation khi Inventory chứng minh terminal" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="2862" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="34" value="opt [token có giá trị]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3304" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="37" value="ref  SD02 Tại Procurement: WAREHOUSE_STAFF; requireCsrf=true" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD02">
