        <mxCell id="7" value="6. Token; trình duyệt giữ cookie" style="endArrow=open;endFill=0;dashed=1;strokeColor=#334155;strokeWidth=1.4;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=282;verticalAlign=bottom;spacingBottom=8;rounded=0;" edge="1" parent="1">
