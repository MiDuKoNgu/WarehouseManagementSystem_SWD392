          <mxGeometry x="1895" y="1839" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="28" value="CONFIRM: DRAFT, chưa có Inbound, Validate lại PO. CANCEL: DRAFT/CONFIRMED, chưa có bất kỳ Inbound. CLOSE: CONFIRMED, không còn Inbound mở; closedQuantity=ordered−received. Các điều kiện không đạt → 400/409, không ghi." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="2709" width="3350" height="86" as="geometry" />
        </mxCell>
        <mxCell id="29" value="ref  SD04.OPTIONS GetOptionsAsync; CONFIRM dùng để Validate lại PO" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD04">
          <mxGeometry x="1275" y="2823" width="2120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="34" value="opt [target=CANCELLED hoặc CLOSED]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
