          <mxGeometry x="40" y="2507" width="2110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="34" value="ref  SD07.LOAD Load(id) lấy ReceiptDetail + RowVersion mới" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD07">
          <mxGeometry x="965" y="3053" width="1190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="38" value="Không vẽ ba cấu trúc CRUD lặp lại. REMOVE không gọi InboundRules.Validate(request) và không lấy PO; vẫn kiểm DRAFT/version. Save chỉ ghi InboundItem; SerialItem được tạo ở SD09 khi complete." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="3475" width="2110" height="86" as="geometry" />
        </mxCell>
        <mxCell id="68" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="3681" width="2120" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
