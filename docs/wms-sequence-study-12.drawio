          <mxGeometry x="40" y="1678" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="20" value="par [Catalog và Warehouse gọi đồng thời]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="1832" width="3040" height="32" as="geometry" />
        </mxCell>
