          <mxGeometry x="40" y="3016" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="38" value="alt [CREATE; dùng lại cho import]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3202" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="39" value="interaction SD04.WRITE_CREATE — Tạo PO trong transaction; action và importKey là tham số" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3260" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="42" value="opt [importKey có giá trị]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3510" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="44" value="Nếu đã có importKey: commit, đọc PO cũ và trả lại; bỏ qua INSERT bên dưới. Nhánh này chống tạo trùng khi retry import." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="3703" width="3040" height="86" as="geometry" />
        </mxCell>
        <mxCell id="50" value="else [UPDATE: cấu trúc gọi giống CREATE, SQL khác]" style="text;fillColor=#ffffff;align=left;fontStyle=1;fontSize=14;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="4205" width="3040" height="35" as="geometry" />
        </mxCell>
        <mxCell id="57" value="UPDATE gọi GetCreatorNameAsync qua Identity trước khi ghi; CREATE dùng tên người tạo từ claims. WRITE_CREATE chỉ đại diện phần repository, không gọi lại frontend/controller. Mỗi lần gọi có transaction riêng." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="4689" width="3040" height="86" as="geometry" />
        </mxCell>
        <mxCell id="102" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="5279" width="3050" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
