        <mxCell id="3" value="ref  SD10 Tiền điều kiện: đã tra cứu/gợi ý; chỉ chạy lại nếu thiếu dữ liệu. Sử dụng serialItemId + targetLocationId + RowVersion." style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD10">
          <mxGeometry x="35" y="339" width="2430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="4" value="ref  SD01 Lấy CSRF token" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD01">
          <mxGeometry x="345" y="471" width="570" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7" value="ref  SD02 WAREHOUSE_STAFF; requireCsrf=true" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD02">
          <mxGeometry x="965" y="795" width="1500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="13" value="ref  SD10.READ_CONTEXT locked=true; cùng connection/transaction đang mở" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD10">
          <mxGeometry x="1585" y="1439" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="20" value="break [Serial/version/kho/target không hợp lệ]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="2206" width="2420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="27" value="break [Vị trí không hợp lệ / không đủ sức chứa]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="2776" width="2420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="39" value="SD10 là tiền điều kiện, không bắt buộc gọi lại suggestions khi bấm Confirm. Mọi lỗi trước commit rollback cả UPDATE/movement/audit. Putaway không cộng tồn kho lần nữa." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="3833" width="2420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="73" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="4039" width="2430" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
