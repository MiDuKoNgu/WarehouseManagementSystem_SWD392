        </mxCell>
        <mxCell id="43" value="break [Không có bằng chứng terminal đúng PO/kho]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="4198" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="54" value="ref  SD07.LOAD Lấy ReceiptDetail mới" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD07">
          <mxGeometry x="965" y="5029" width="2120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="58" value="Inventory đã commit trước HTTP release. Release lỗi không rollback hàng đã nhận; retry dùng trạng thái terminal để tránh nhận lần hai. Lỗi nghiệp vụ=400/403/404/409; nguồn dữ liệu=503. Các transaction chưa commit sẽ rollback." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="5451" width="3040" height="86" as="geometry" />
        </mxCell>
        <mxCell id="103" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="5657" width="3050" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
