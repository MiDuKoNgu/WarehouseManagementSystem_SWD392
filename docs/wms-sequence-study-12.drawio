          <mxGeometry x="2205" y="3489" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="48" value="Nếu CreateAsync ném ReceiptException: AbortCreationAsync khóa cùng phạm vi để chặn retry muộn. Khi có bằng chứng terminal, ref SD09.RELEASE để giải phóng reservation, rồi trả lỗi." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
