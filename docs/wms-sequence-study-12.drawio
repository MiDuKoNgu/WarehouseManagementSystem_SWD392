          <mxGeometry x="40" y="3918" width="2730" height="32" as="geometry" />
        </mxCell>
        <mxCell id="47" value="ref  SD12.EMPLOYEES Bổ sung actor name nếu thiếu" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD12">
          <mxGeometry x="965" y="4109" width="1810" height="90" as="geometry" />
        </mxCell>
        <mxCell id="52" value="Options: GET /options → OptionsAsync → SOURCE_READ(mode=actions) trên hai nguồn + EMPLOYEES song song; gộp KnownActions, distinct/sort. Không cần sequence thứ 13 vì cùng cấu trúc fan-out đã mô tả." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="4659" width="2730" height="86" as="geometry" />
        </mxCell>
        <mxCell id="88" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="4865" width="2740" height="55" as="geometry" />
        </mxCell>
      </root>
