        </mxCell>
        <mxCell id="11" value="Retry complete khi đã DONE / cancel khi đã CANCELLED: bỏ qua mutation; vẫn thực hiện RELEASE và LOAD. Khi chưa terminal, chạy phần bên dưới." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1181" width="3040" height="86" as="geometry" />
        </mxCell>
        <mxCell id="12" value="alt [COMPLETE và chưa DONE]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="3040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="13" value="ref  SD07.ORDER Lấy PO hiện tại để kiểm và hoàn tất phiếu" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD07">
