            <mxPoint x="468" y="735" as="sourcePoint" />
            <mxPoint x="172" y="735" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="8" value="Hậu điều kiện: frontend có token cho X-CSRF-TOKEN. Endpoint có [SkipUserLookup], không truy vấn SQL. Nếu có cookie phiên, antiforgery vẫn gắn token với danh tính tương ứng. Lỗi HTTP → caller dừng mutation." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="821" width="1180" height="86" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="1027" width="1190" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
