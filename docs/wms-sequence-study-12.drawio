        <mxCell id="12" value="9. Kiểm version + trạng thái; Cancel/Close kiểm reason 1..1000 ký tự" style="endArrow=block;endFill=1;dashed=0;strokeColor=#334155;strokeWidth=1.4;fontSize=14;fontFamily=Arial;labelBackgroundColor=#ffffff;whiteSpace=wrap;labelWidth=235;verticalAlign=bottom;spacingBottom=8;rounded=0;" edge="1" parent="1">
