        <mxCell id="16" value="interaction SD06.RECEIVING — Đọc tiến độ nhận hàng qua Inventory" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
