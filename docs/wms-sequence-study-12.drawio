        <mxCell id="27" value="Thao tác tiếp theo chỉ thực hiện khi Valid=true. Preview chỉ lưu bộ nhớ, chưa ghi database. Tải template là GET → TemplateAsync → OPTIONS → workbook.CreateTemplate, không tạo PO." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="2511" width="2730" height="86" as="geometry" />
        </mxCell>
        <mxCell id="29" value="ref  SD01 Lấy token CSRF mới" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD01">
          <mxGeometry x="345" y="2721" width="570" height="90" as="geometry" />
        </mxCell>
        <mxCell id="32" value="ref  SD02 PURCHASING_STAFF; requireCsrf=true" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD02">
          <mxGeometry x="965" y="3045" width="1810" height="90" as="geometry" />
        </mxCell>
        <mxCell id="36" value="break [Token sai / hết hạn / khác user]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3460" width="2730" height="32" as="geometry" />
        </mxCell>
        <mxCell id="41" value="alt [Entry.CreatedId đã có]" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="3838" width="2730" height="32" as="geometry" />
        </mxCell>
        <mxCell id="46" value="service.FindAsync bổ sung ReceivingSummary, options và tên người tạo như SD06.RECEIVING / SD04.OPTIONS; không INSERT thêm." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="4287" width="2730" height="86" as="geometry" />
        </mxCell>
        <mxCell id="47" value="else [Chưa tạo; kiểm lại ExpiresAt]" style="text;fillColor=#ffffff;align=left;fontStyle=1;fontSize=14;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="4405" width="2730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="49" value="ref  SD04.OPTIONS Lấy danh mục và Validate(entry.Request)" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD04">
          <mxGeometry x="1275" y="4471" width="1500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="51" value="ref  SD04.WRITE_CREATE request=entry.Request; action=IMPORT_PO_EXCEL; importKey=SHA256(token). Nhận StoredPurchaseOrder." style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD04">
          <mxGeometry x="1275" y="4731" width="1500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="59" value="Confirm import tạo DRAFT. DRAFT → CONFIRMED là SD06, không phải thao tác này. Lỗi workbook/validation=400; preview conflict=409; nguồn dịch vụ=503." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="5537" width="2730" height="86" as="geometry" />
        </mxCell>
        <mxCell id="99" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="5743" width="2740" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
