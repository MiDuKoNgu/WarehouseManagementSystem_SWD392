        <mxCell id="13" value="ref  SD02 Mỗi service nguồn: ADMIN; requireCsrf=false" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD02">
          <mxGeometry x="1275" y="1189" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="21" value="SOURCE_READ được thực thi 2 lần đồng thời cho mode=page: source=inventory và source=procurement. Chỉ vẽ cấu trúc một lần; hai service có cùng AuditReadControllerBase + SqlAuditReader." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1963" width="2730" height="86" as="geometry" />
        </mxCell>
        <mxCell id="22" value="and [Employees]" style="text;fillColor=#ffffff;align=left;fontStyle=1;fontSize=14;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="2081" width="2730" height="35" as="geometry" />
        </mxCell>
        <mxCell id="24" value="interaction SD12.EMPLOYEES — Lấy tên nhân viên" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="2142" width="2730" height="32" as="geometry" />
        </mxCell>
        <mxCell id="35" value="WMS.API xử lý endpoint admin cục bộ và tổng hợp; không proxy endpoint này sang một service duy nhất. Lỗi một nguồn → 503, không trả dữ liệu thiếu nguồn." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="3071" width="2730" height="86" as="geometry" />
        </mxCell>
        <mxCell id="38" value="ref  SD02 ADMIN; requireCsrf=false" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD02">
          <mxGeometry x="655" y="3377" width="2120" height="90" as="geometry" />
        </mxCell>
