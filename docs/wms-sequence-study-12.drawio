        <mxCell id="11" value="interaction SD12.SOURCE_READ — Một cấu trúc đọc; source={inventory|procurement}, mode={page|detail|actions}" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
