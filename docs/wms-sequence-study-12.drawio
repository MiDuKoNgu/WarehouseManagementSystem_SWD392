        <mxCell id="20" value="interaction SD10.READ_CONTEXT — Đọc ngữ cảnh putaway; tham số locked=false/true" style="text;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fontFamily=Arial;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="2070" width="2420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="23" value="SQL cross-database trên cùng instance, không gọi Catalog.API/Warehouse.API. locked=true dùng transaction và HOLDLOCK/UPDLOCK; SD11 tự đọc Occupants sau kiểm version/guard." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="2327" width="2420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="36" value="Serial hợp lệ: ở kho được giao, IN_WAREHOUSE, chưa có location; nguồn PURCHASE phải có Inbound DONE. Schema claim/stocktake chưa tích hợp → 503. Gợi ý chưa giữ chỗ; SD11 kiểm lại khi ghi." style="shape=note;size=14;fillColor=#fff9e6;strokeColor=#d5b86b;fontSize=14;fontFamily=Arial;align=left;spacing=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="3531" width="2420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="70" value="Ghi chú ký hiệu: activation kéo dài khi caller chờ kết quả; lỗi trong break kết thúc tương tác đó. Ref có thể che chi tiết các lifeline nội bộ. Một nhãn SQL có thể gộp nhiều câu lệnh trong cùng transaction. Lifeline ghi nhiều tên là phần đã được gộp có chủ ý để sơ đồ dễ đọc." style="text;align=left;fontSize=12;fontFamily=Arial;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="35" y="3737" width="2430" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
