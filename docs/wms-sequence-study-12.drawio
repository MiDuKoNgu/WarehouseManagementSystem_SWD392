        <mxCell id="43" value="ref  SD12.SOURCE_READ mode=detail; source được chọn; chỉ đọc một nguồn" style="rounded=0;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;fontSize=14;fontFamily=Arial;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=9;" vertex="1" parent="1" link="data:page/SD12">
